Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\DriveDrop]
@="Subir con DriveDrop"
"Icon"="C:\Users\ashla\OneDrive\Documentos\DriveDrop\assets\drivedrop.ico"

